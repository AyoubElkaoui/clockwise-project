# Clockd backend-configuratie. Kopieer naar C:\Clockd\clockd.env en vul in.
# Eén regel per variabele: NAAM=waarde  (geen aanhalingstekens, geen spaties rond '=')
# Dit bestand bevat wachtwoorden: nooit in git zetten, alleen op de server.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5000

ConnectionStrings__Firebird=Database=C:\ProgramData\Syntess\AtriumData\Databases\TST\ATRIUM.FDB;User=SYSDBA;Password=VUL_IN;Dialect=3;Charset=UTF8;ServerType=0;Server=localhost;Port=3050;Pooling=true;MinPoolSize=5;MaxPoolSize=100;ConnectionLifetime=300
ConnectionStrings__PostgreSQL=Host=VUL_IN.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=VUL_IN;SSL Mode=Require;Trust Server Certificate=true

# Minimaal 32 willekeurige tekens
Jwt__Key=VUL_IN
# Exact 32 tekens
TwoFactor__EncryptionKey=VUL_IN

# Link in herinneringsmails
App__BaseUrl=https://clockd.nl

# Optioneel: zonder SmtpHost/SmtpUser/SmtpPassword worden er geen mails verstuurd
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromEmail=noreply@clockd.nl
Email__FromName=Clockd

# Optioneel: Atrium-sleutels overschrijven (zie backend/Models/SyntessOptions.cs), bijv.
# Syntess__AdminisGcId=1
